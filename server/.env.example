NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/substitute_recommender
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Requests allowed per IP per 15 minutes (login and the public demo have their own stricter limits)
RATE_LIMIT_MAX=1000

# ---- AI layer (all optional; the app works fully rule-based with AI_ENABLED=false) ----
AI_ENABLED=false
# local = built-in lexical hashing embeddings (no key, not truly semantic)
# openai = real semantic embeddings (needs OPENAI_API_KEY)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Blend weights (0..1): how much AI signals count versus the rule-based scores
AI_SIMILARITY_WEIGHT=0.4
AI_LEARNING_WEIGHT=0.3
# Optional LLM-written explanation sentences (facts come from the engine; LLM only rephrases)
AI_EXPLANATIONS=false
ANTHROPIC_API_KEY=
EXPLANATION_MODEL=claude-haiku-4-5-20251001
